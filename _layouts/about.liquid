---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>
    <!-- Projects -->
    
  {%- comment -%}
Collect all docs from pages + every collection (e.g., _pages, _projects) + posts
{%- endcomment -%}
{% assign all_docs = site.pages %}
{% for c in site.collections %}
  {% assign all_docs = all_docs | concat: c.docs %}
{% endfor %}
{% if site.posts %}
  {% assign all_docs = all_docs | concat: site.posts %}
{% endif %}

{%- comment -%}
Filter for featured work items and sort by importance (fallback to title)
{%- endcomment -%}
{% assign highlighted = all_docs | where: "featured", true | where: "category", "work" %}
{% assign highlighted = highlighted | sort: "importance" %}
{% if highlighted == empty %}
  {%- comment -%} Nothing matched; show nothing silently {%- endcomment -%}
{% else %}
  <h2>highlighted projects</h2>
  <div class="projects-grid">
    {% for p in highlighted %}
      <a class="project-card" href="{{ p.url | relative_url }}">
        <div class="project-thumb">
          {% if p.img %}
            {% include figure.liquid
              loading="lazy"
              path=p.img
              class="project-img"
              alt=p.title
              cache_bust=true
            %}
          {% else %}
            <div class="project-img" style="display:flex;align-items:center;justify-content:center;">
              <span style="opacity:.6;padding:1rem;">No preview</span>
            </div>
          {% endif %}
        </div>
        <div class="project-meta">
          <div class="project-title">{{ p.title | default: "Untitled project" }}</div>
          {% if p.blurb %}
            <div class="project-blurb">{{ p.blurb }}</div>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
{% endif %}


    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>


<!-- Custom CSS for highlighted projects -->
<style>
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
  margin: 12px 0 24px;
}
.project-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.08);
  background: #fff;
  transition: transform 0.08s ease, box-shadow 0.12s ease;
}
.project-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.10);
}
.project-thumb {
  background: #fafafa;
  display: block;
}
.project-img {
  width: 100%;
  height: 180px;
  object-fit: cover;    /* use 'contain' if you never want cropping */
  border-radius: 0;
  box-shadow: none;
}
.project-meta {
  padding: 12px 14px 14px;
}
.project-title {
  font-weight: 700;
  font-size: 1.02rem;
  line-height: 1.3;
  color: inherit;
  margin-bottom: 6px;
}
.project-blurb {
  color: #555;
  font-size: 0.95rem;
  line-height: 1.45;
}
@media (max-width: 576px) {
  .project-img { height: 160px; }
}
</style>